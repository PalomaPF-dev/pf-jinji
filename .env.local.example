# PF人事マスター（pf-jinji）環境変数のひな形。
# 実際の値は .env.local（gitignore 済み）または Vercel の環境変数に入れる。
# ※ 人事情報を扱うため、値そのものは絶対にコミットしないこと。

# ===== データベース =====
# pf-jinji 専用の Neon プロジェクト。給与・考課を他アプリのDBから物理的に分離する。
# ローカル Postgres を使う場合は DB_DRIVER=pg を併記する（.neon.tech 以外は自動判定でも pg）。
DATABASE_URL=postgres://user:password@localhost:5432/jinji_dev
# DB_DRIVER=pg

# ===== 認証（next-auth）=====
# 本番は https://jinji.paloma-pf.com を入れる。
# パスワード設定リンクの生成にも使うため、実際に配信するURLと必ず一致させること。
NEXTAUTH_URL=http://localhost:5190
# openssl rand -base64 32 などで生成
NEXTAUTH_SECRET=

# ===== ポータル連携 =====
# ポータルと共有する鍵。SSO（/api/sso）とプロビジョニング（/api/provision）の両方で使う。
PF_PROVISION_KEY=
# 部署マスター取込元。既定は https://portal.paloma-pf.com
PORTAL_BASE_URL=https://portal.paloma-pf.com

# ===== 初期セットアップ =====
# 利用許可名簿へ owner として自動登録する社員番号（カンマ区切り）。
# 未設定なら名簿は空のままで、/setup 画面から最初の1人を登録する。
JINJI_BOOTSTRAP_ADMIN_IDS=
# 統一管理者 'admin' の bcrypt ハッシュ（PFシリーズ共通の任意設定）
PF_ADMIN_BOOTSTRAP_HASH=

# ===== 資格の期限アラート（cron）=====
# /api/cron/alerts を叩くときの Bearer トークン
CRON_SECRET=
# 何日前に警告するか（カンマ区切り・降順）
ALERT_LEAD_DAYS=90,30,7
